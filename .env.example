# =============================================================================
# .env.example — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in every value before running the stack.
#
#   cp .env.example .env
#
# NEVER commit your real .env file to version control.
# =============================================================================


# =============================================================================
# AWS Credentials
# =============================================================================
# Required for: Airflow DAGs (ingestion, processing, warehouse), Spark jobs.
#
# How to get:
#   1. Log in to the AWS Console → https://console.aws.amazon.com/
#   2. Navigate to IAM → Users → <your-user> → Security credentials
#   3. Click "Create access key" and download the CSV.
#   Required IAM permissions: s3:GetObject, s3:PutObject, s3:ListBucket,
#                              s3:CreateBucket, s3:DeleteObject
# =============================================================================
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_DEFAULT_REGION=us-east-1

# The S3 bucket where raw and Silver Parquet data will be stored.
# Must be globally unique. Example: my-company-nginx-logs-2026
S3_BUCKET_NAME=YOUR_GLOBALLY_UNIQUE_S3_BUCKET_NAME


# =============================================================================
# MotherDuck (Cloud DuckDB) 
# "I have used the free trial to make this project"
# =============================================================================
# Required for: DAG C (nginx_warehouse), dbt models, scripts/setup_motherduck.py
#
# How to get your token:
#   1. Sign up / log in at https://app.motherduck.com/
#   2. Go to Settings (top-right avatar) → Access Tokens
#   3. Click "Generate token" and copy it here.
# =============================================================================
MOTHERDUCK_TOKEN=YOUR_MOTHERDUCK_TOKEN_HERE

# The name of the MotherDuck database to create and use.
# This will be created automatically if it doesn't exist.
MOTHERDUCK_DATABASE=nginx_analytics


# =============================================================================
# Kaggle API Credentials
# =============================================================================
# Required for: DAG A (nginx_ingestion) — downloads the source dataset.
#
# How to get:
#   1. Log in to https://www.kaggle.com/
#   2. Go to your Profile → Settings → API section
#   3. Click "Create New Token" — this downloads a kaggle.json file.
#   4. Copy the "username" value → KAGGLE_USERNAME
#   5. Copy the "key" value      → KAGGLE_KEY
# =============================================================================
KAGGLE_USERNAME=YOUR_KAGGLE_USERNAME_HERE
KAGGLE_KEY=YOUR_KAGGLE_API_KEY_HERE


# =============================================================================
# PostgreSQL — Airflow Metadata Database
# =============================================================================
# These credentials are used by the Postgres Docker container AND to build
# the Airflow SQLAlchemy connection string dynamically below.
#
# You can choose any username, password, and database name you like.
# They only need to be consistent within this file.
# =============================================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_airflow_db_password
POSTGRES_DB=airflow


# =============================================================================
# Airflow Configuration
# =============================================================================
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN is built dynamically from the Postgres
# variables above so there is only one source of truth for credentials.
# The format is: postgresql+psycopg2://<USER>:<PASSWORD>@postgres:5432/<DB>
#
# ⚠️  Do NOT change the hostname "postgres" — it is the Docker service name.
# =============================================================================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Fernet key for encrypting secrets stored in the Airflow DB.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=YOUR_GENERATED_FERNET_KEY_HERE

# Secret key for Airflow's web session cookies.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=YOUR_GENERATED_WEBSERVER_SECRET_KEY_HERE

# Airflow admin user credentials (created on first boot by airflow-init)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.com


# =============================================================================
# Apache Superset
# =============================================================================
# SECRET_KEY is used to sign browser sessions. Must be a long random string.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(42))"
# =============================================================================
SUPERSET_SECRET_KEY=YOUR_GENERATED_SUPERSET_SECRET_KEY_HERE
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_me_superset_admin_password
SUPERSET_ADMIN_EMAIL=admin@example.com
